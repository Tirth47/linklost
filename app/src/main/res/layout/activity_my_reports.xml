<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvMyReportsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Reports"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvMyReportsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Items you have reported"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/tvMyReportsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reports List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMyReports"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMyReportsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvNoReports"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="You haven't reported any items yet."
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerMyReports"
        app:layout_constraintBottom_toBottomOf="@id/recyclerMyReports"
        app:layout_constraintStart_toStartOf="@id/recyclerMyReports"
        app:layout_constraintEnd_toEndOf="@id/recyclerMyReports" />

</androidx.constraintlayout.widget.ConstraintLayout>